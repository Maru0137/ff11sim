{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        // 既存 JS (web/js/) は import はできるが型検査しない。
        // TS 化は段階的移行の最終フェーズ (docs/roadmap/react-migration.md)。
        "allowJs": true,
        "checkJs": false,
        "lib": ["esnext", "dom", "dom.iterable"],
        "types": ["vite/client", "node"]
    },
    "include": ["web/src"]
}
